{
  "schemaVersion": 3,
  "id": "droneclassbalance",
  "displayName": "DroneClassBalance",
  "version": "0.2.0",
  "description": "Server-side class-based drone bandwidth, active-drone and bay rules.",
  "kind": "loader",
  "supportedBackends": [
    "native"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.8",
      "0.12.9"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "settings.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "logMatches",
        "label": "Log changed ship rules",
        "type": "boolean",
        "default": true,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "logMatches"
        ],
        "advanced": true
      },
      {
        "id": "destroyer.bandwidth",
        "label": "Destroyer: drone bandwidth multiplier",
        "type": "number",
        "default": 1,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "classes",
          "Destroyer",
          "bandwidthMultiplier"
        ],
        "group": "Destroyer",
        "minimum": 0.01,
        "maximum": 100
      },
      {
        "id": "destroyer.active",
        "label": "Destroyer: active drone limit (0 = native)",
        "type": "integer",
        "default": 0,
        "restart": "game_server",
        "file": "preferences",
        "key": [
          "classes",
          "Destroyer",
